# Optional custom directory for 1C sync snapshots (defaults to /data/1c-cache on Amvera or .cache locally)
ONEC_CACHE_DIR=

# Optional local Windows path to 1C JSON export file (used only when process.platform === "win32")
ONEC_WINDOWS_EXPORT_PATH=

# Optional DaData API key for company lookup (if omitted, official open FNS EGRUL API https://egrul.nalog.ru is used)
DADATA_API_KEY=

