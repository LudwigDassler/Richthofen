# ==============================================================================
# СЛОЙ 1: Серверный «ИИ-главбух» (JSON семантический разбор хозяйственных операций)
# Ключи передаются строго на сервере (Amvera Variables / Secrets или .env.local).
# Если ключи не заданы, приложение автоматически работает на детерминированном
# офлайн-ядре 1С:Бухгалтерия 8.3 (ред. 3.0).
# ==============================================================================

# Вариант А: Google Gemini API
GEMINI_API_KEY=
# Модель по умолчанию: gemini-2.5-flash (резервная: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Вариант Б: OpenAI-совместимый LLM API (DeepSeek, OpenRouter, Qwen, GigaChat, vLLM)
# Пример для DeepSeek: https://api.deepseek.com/v1 (модель: deepseek-chat)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ==============================================================================
# Интеграция со справочниками ФНС ЕГРЮЛ и 1С:Предприятие 8.3
# ==============================================================================

# Опциональный API-ключ DaData для поиска контрагентов (если пусто — используется
# открытый официальный сервис ФНС России https://egrul.nalog.ru)
DADATA_API_KEY=

# Директория хранения снэпшотов синхронизации 1С (по умолчанию /data/1c-cache на Amvera или .cache локально)
ONEC_CACHE_DIR=

# Опциональный локальный путь к JSON-выгрузке 1С на Windows
ONEC_WINDOWS_EXPORT_PATH=
